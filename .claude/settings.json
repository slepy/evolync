{
  "permissions": {
    "allow": [
      "Bash(npm install:*)",
      "Bash(npm run start)",
      "Bash(npm run android)",
      "Bash(npm run ios)",
      "Bash(npm run web)",
      "Bash(npm run typecheck)",
      "Bash(npx expo start:*)",
      "Bash(git status)",
      "Bash(git status:*)",
      "Bash(git diff)",
      "Bash(git diff:*)",
      "Bash(git log)",
      "Bash(git log:*)",
      "Bash(git branch)",
      "Bash(git branch:*)",
      "Bash(open http://localhost:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path // empty' | { read -r f; case \"$f\" in *.ts|*.tsx) npm run typecheck --silent 2>&1 | head -50 ;; esac; } ; true",
            "timeout": 60,
            "statusMessage": "Typechecking..."
          }
        ]
      }
    ]
  }
}
